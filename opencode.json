{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "grep *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "find *": "allow",
      "cat *": "allow",
      "sort *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "./gradlew testDebugUnitTest*": "allow",
      "./gradlew assembleDebug*": "allow",
      "./gradlew generateFixtures*": "allow",
      "./gradlew check*": "allow",
      "./gradlew :app:compile*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git rebase*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git restore*": "deny",
      "git stash*": "deny"
    }
  }
}
