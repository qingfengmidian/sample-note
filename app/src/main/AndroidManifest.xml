<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- M18（F4.10）：Android 11+ 包可见性。非权限、无运行时申请；声明 SEND/text/plain 接收方
         与预设包名，使「复制后问 AI」的目标应用枚举与 getApplicationInfo 可见。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <package android:name="com.deepseek.chat" />
        <package android:name="com.larus.nova" />
    </queries>

    <!-- U2（M10）：DayNight 主题（values/values-night 资源对），替代硬编码 Light -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DocReader">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 从其他应用/文件管理器打开文档（F1.1）：(content|file) × (text/*|epub|octet-stream) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="text/*" />
                <data android:scheme="content" android:mimeType="application/epub+zip" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="file" android:mimeType="text/*" />
                <data android:scheme="file" android:mimeType="application/epub+zip" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
    </application>

</manifest>
